{
    "name": "iv0ks/brewdocs",
    "description": "Brewdocs — Intentionally vulnerable path traversal lab (PHP knowledge base)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^1.12"
    },
    "autoload": {
        "psr-4": {
            "Brewdocs\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "stan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}
